{
  "name": "reminder_scheduler",
  "package_version": "1.0.0",
  "package_files_sha256": {
    "skill.md": "55a7d6dcb6354dbc6c4c733b14f12c9d23d7458ef155ab084540d6c0b2b88c84",
    "tool.py": "d3972c533046f78be77c46798298479d49187d140efe858ee24f12e67b2b8585"
  },
  "description": "Creates, lists and deletes scheduled reminders and notifications",
  "entrypoint": "tool.py",
  "function": "reminder_scheduler",
  "schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "Action: create, list or delete",
        "enum": [
          "create",
          "list",
          "delete"
        ]
      },
      "chat_id": {
        "type": "integer",
        "description": "Target chat id. If omitted, agent may inject current chat id automatically"
      },
      "org_id": {
        "type": "string",
        "description": "Organization tenant id"
      },
      "team_id": {
        "type": "string",
        "description": "Team id within organization"
      },
      "user_id": {
        "type": "integer",
        "description": "User id in tenant context"
      },
      "reminder_id": {
        "type": "string",
        "description": "Reminder id for delete action"
      },
      "title": {
        "type": "string",
        "description": "Short reminder title"
      },
      "prompt": {
        "type": "string",
        "description": "Additional instructions to LLM from user if provided when reminder triggers else send only title directly to User"
      },
      "text": {
        "type": "string",
        "description": "Alias for prompt"
      },
      "message": {
        "type": "string",
        "description": "Alias for prompt"
      },
      "query": {
        "type": "string",
        "description": "Alias for prompt"
      },
      "task": {
        "type": "string",
        "description": "Alias for prompt"
      },
      "instruction": {
        "type": "string",
        "description": "Alias for prompt"
      },
      "notify_text": {
        "type": "string",
        "description": "Optional user-facing preface shown before LLM answer"
      },
      "schedule_type": {
        "type": "string",
        "description": "Schedule type: once, interval, daily, cron",
        "enum": [
          "once",
          "interval",
          "daily",
          "cron"
        ],
        "default": "once"
      },
      "once_at": {
        "type": "string",
        "description": "ISO datetime for one-time reminder, for example 2026-03-20T09:00:00+05:00"
      },
      "interval_seconds": {
        "type": "integer",
        "description": "Repeat interval in seconds for schedule_type=interval"
      },
      "time_of_day": {
        "type": "string",
        "description": "Daily time in HH:MM for schedule_type=daily"
      },
      "cron_expr": {
        "type": "string",
        "description": "Cron expression for schedule_type=cron, for example */15 * * * *"
      },
      "timezone": {
        "type": "string",
        "description": "IANA timezone, for example Asia/Almaty",
        "default": "UTC"
      },
      "max_runs": {
        "type": "integer",
        "description": "Optional max number of runs for repeating reminders"
      },
      "active_only": {
        "type": "boolean",
        "description": "For list action: include only active reminders",
        "default": true
      }
    },
    "required": [
      "action"
    ]
  },
  "package_signature_algorithm": "hmac-sha256",
  "package_signature": "72ec429b1ce61391f0fa92e7cbd10eb0b074979c372b7a27365123c6ca9b1090"
}

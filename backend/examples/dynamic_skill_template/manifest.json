{
  "name": "weather_custom_skill",
  "version": "1.0.0",
  "entrypoint": "skill.py",
  "function": "run",
  "description": "Example dynamic skill template",
  "input_schema": {
    "type": "object",
    "properties": {
      "city": {
        "type": "string",
        "description": "Target city name"
      }
    },
    "required": ["city"]
  },
  "capabilities": {
    "llm": {
      "enabled": true,
      "max_calls": 1,
      "max_prompt_chars": 1200,
      "max_response_chars": 800
    }
  }
}

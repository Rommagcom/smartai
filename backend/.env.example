APP_NAME=AI Personal Assistant Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://assistant:assistant@postgres:5432/assistant
JWT_SECRET_KEY=change-me-very-strong
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# OLLAMA_BASE_URL modes:
# 1) Ollama in docker-compose service: http://ollama:11434
# 2) Ollama on host machine (GPU), backend in containers: http://host.docker.internal:11434
# 3) Backend started on host (no Docker): http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_NAME=gpt-oss:120b
OLLAMA_MODEL_FALLBACK_ENABLED=false
# Preferred LiteLLM model key (optional). If omitted, app falls back to:
# LLM_MODEL -> OLLAMA_MODEL_NAME
# LLM_MODEL=ollama_chat/kimi-k2.5:cloud
OLLAMA_TIMEOUT_SECONDS=120

MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=user_knowledge_base
EMBEDDING_DIM=1024

REDIS_URL=redis://redis:6379/0
# Optional split for Redis topology with primary+replica:
# - REDIS_WRITE_URL must point to writable primary
# - REDIS_READ_URL can point to replica (or stay empty)
REDIS_WRITE_URL=redis://redis:6379/0
REDIS_READ_URL=redis://redis-replica:6379/0
WORKER_QUEUE_KEY=assistant:worker:queue
WORKER_PROCESSING_QUEUE_KEY=assistant:worker:processing
WORKER_RETRY_ZSET_KEY=assistant:worker:retry
WORKER_RESULT_QUEUE_PREFIX=assistant:worker:result
WORKER_RESULT_QUEUE_MAX_ITEMS=200
WORKER_RESULT_TTL_SECONDS=86400
WORKER_BRPOP_TIMEOUT_SECONDS=5
WORKER_MAX_RETRIES=3
WORKER_DEDUPE_WINDOW_SECONDS=300
WORKER_RETRY_BASE_DELAY_SECONDS=10
WORKER_RETRY_MAX_DELAY_SECONDS=300
WORKER_RUNNING_LEASE_SECONDS=180
WORKER_PROCESSING_RECOVERY_BATCH=200

WORKER_ENABLED=true
SCHEDULER_ENABLED=true
SCHEDULER_JOB_MISFIRE_GRACE_SECONDS=300
SCHEDULER_ONCE_MAX_LAG_SECONDS=300
SCHEDULER_INACTIVITY_REMINDER_ENABLED=true
SCHEDULER_INACTIVITY_REMINDER_AFTER_HOURS=72
SCHEDULER_INACTIVITY_REMINDER_COOLDOWN_HOURS=24
SCHEDULER_INACTIVITY_REMINDER_BATCH_LIMIT=200
SCHEDULER_INACTIVITY_REMINDER_LLM_ENABLED=true
SCHEDULER_INACTIVITY_REMINDER_MIN_HOURS=6
SCHEDULER_INACTIVITY_REMINDER_MAX_HOURS=168
SCHEDULER_INACTIVITY_REMINDER_MESSAGE=Давно не виделись. Если хотите, помогу с задачами на сегодня.

WEBSOCKET_SEND_TIMEOUT_SECONDS=2.0
WS_FANOUT_REDIS_ENABLED=true
WS_FANOUT_CHANNEL_PREFIX=assistant:ws:fanout

WEB_FETCH_TIMEOUT_SECONDS=25
WEB_SEARCH_TIMEOUT_SECONDS=25
SEARXNG_BASE_URL=
BROWSER_HEADLESS=true
CHROME_EXECUTABLE_PATH=

SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_IMAGE=python:3.11-alpine
DYNAMIC_SKILL_RUNNER_URL=http://skill-runner:8081
DYNAMIC_SKILL_RUNNER_SECRET=change-me-skill-runner-secret
DYNAMIC_SKILL_RUNNER_TIMEOUT_SECONDS=45
DYNAMIC_SKILL_SANDBOX_IMAGE=smartai-skill-runner:latest
DYNAMIC_SKILL_SANDBOX_TIMEOUT_SECONDS=30
DYNAMIC_SKILL_SANDBOX_NETWORK=smartai-sandbox-net
DYNAMIC_SKILL_LLM_CALLBACK_ENABLED=true

MEMORY_DEFAULT_TTL_DAYS=0
MEMORY_DECAY_HALF_LIFE_DAYS=45
MEMORY_DECAY_MIN_FACTOR=0.35

TELEGRAM_BOT_TOKEN=8567970867:AAEsEhEH6thRcNQVUQZlZgENttJK0k0uBdw
BACKEND_API_BASE_URL=http://api:8000/api/v1
TELEGRAM_BACKEND_BRIDGE_SECRET=change-me-telegram-bridge-secret
TELEGRAM_POLL_CONCURRENCY=10
TELEGRAM_KNOWN_USER_TTL_SECONDS=86400
TELEGRAM_PDF_CREATE_TIMEOUT_SECONDS=300
TELEGRAM_DOCUMENT_UPLOAD_TIMEOUT_SECONDS=1200
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ALLOWED_PHONE_NUMBERS=
WHATSAPP_BACKEND_BRIDGE_SECRET=change-me-whatsapp-bridge-secret
WHATSAPP_DEFAULT_TIMEOUT_SECONDS=60
WHATSAPP_CHAT_TIMEOUT_SECONDS=300
TEAMS_ENABLED=false
TEAMS_AUTH_MODE=header-secret
TEAMS_WEBHOOK_SECRET=
TEAMS_ALLOWED_USER_IDS=
TEAMS_BACKEND_BRIDGE_SECRET=change-me-teams-bridge-secret
TEAMS_DEFAULT_TIMEOUT_SECONDS=60
TEAMS_CHAT_TIMEOUT_SECONDS=300
WORKER_RESULT_REDIS_TIMEOUT_SECONDS=5

HTTP_CLIENT_MAX_CONNECTIONS=200
HTTP_CLIENT_MAX_KEEPALIVE_CONNECTIONS=50
HTTP_CLIENT_KEEPALIVE_EXPIRY_SECONDS=30

INTEGRATION_ONBOARDING_SESSION_TTL_SECONDS=86400
RAG_EMBEDDING_CONCURRENCY=4
RAG_DOC_CHUNK_SIZE=1800
RAG_DOC_CHUNK_OVERLAP=300
RAG_DOC_LARGE_TEXT_THRESHOLD_CHARS=700000
RAG_DOC_LARGE_CHUNK_SIZE=6000
RAG_DOC_LARGE_CHUNK_OVERLAP=500

OBS_LOG_LEVEL=DEBUG
OBS_THIRD_PARTY_LOG_LEVEL=WARNING
DEV_VERBOSE_LOGGING=true
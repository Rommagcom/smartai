TELEGRAM_BOT_TOKEN=
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_THINK=true
OLLAMA_BASE_URL=http://ollama:11434
# For docker-compose.host-ollama.yml use:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="personal-assistant"

DYNAMIC_SKILLS_DIR=skills
ENABLE_DYNAMIC_TOOLS=true
GROUP_CHAT_SHARED_SKILLS=false
DYNAMIC_TOOLS_ALLOWLIST=*
DYNAMIC_SKILL_STRICT_ARGS=true
DYNAMIC_SKILL_MAX_STRING_LENGTH=10000
DYNAMIC_SKILL_MAX_ARGS_BYTES=50000
DYNAMIC_SKILL_TIMEOUT_SECONDS=600
DYNAMIC_SKILL_REQUIRE_INTEGRITY=true
DYNAMIC_SKILL_REQUIRE_SIGNATURE=true
DYNAMIC_SKILL_SIGNING_KEY=CHANGE_ME_STRONG_RANDOM_SECRET
MAX_TOOL_RESULT_CHARS=1000000
AGENT_MAX_STEPS=8
MAX_CONVERSATION_MESSAGES=12
TELEGRAM_ADMIN_USER_IDS=''
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=sai:chat
REDIS_CONVERSATION_TTL_SECONDS=604800
INCLUDE_TOKEN_USAGE_IN_RESPONSE=true
REMINDER_POLL_INTERVAL_SECONDS=10
REMINDER_MAX_JOBS_PER_TICK=10
REMINDER_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/sai_reminders
ENABLE_LONG_TERM_MEMORY=true
LONG_TERM_MEMORY_TOP_K=4
LONG_TERM_MEMORY_EMBEDDING_MODEL=nomic-embed-text:latest
LONG_TERM_MEMORY_MAX_ENTRY_CHARS=2000
LONG_TERM_MEMORY_EMBEDDING_TIMEOUT_SECONDS=20
LONG_TERM_MEMORY_EMBEDDING_RETRY_ATTEMPTS=3
LONG_TERM_MEMORY_EMBEDDING_RETRY_BASE_DELAY_SECONDS=0.5
LONG_TERM_MEMORY_EMBEDDING_RETRY_MAX_DELAY_SECONDS=4
LONG_TERM_MEMORY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LONG_TERM_MEMORY_CIRCUIT_BREAKER_RECOVERY_SECONDS=60
LONG_TERM_MEMORY_RETENTION_DAYS=90
LONG_TERM_MEMORY_ARCHIVE_BATCH_SIZE=500
LONG_TERM_MEMORY_MAINTENANCE_INTERVAL_SECONDS=300
RBAC_ENABLED=true

TELEGRAM_BOT_TOKEN=
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_THINK=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="personal-assistant"

DYNAMIC_SKILLS_DIR=skills
ENABLE_DYNAMIC_TOOLS=true
DYNAMIC_TOOLS_ALLOWLIST=*
DYNAMIC_SKILL_STRICT_ARGS=true
DYNAMIC_SKILL_MAX_STRING_LENGTH=10000
DYNAMIC_SKILL_MAX_ARGS_BYTES=50000
DYNAMIC_SKILL_TIMEOUT_SECONDS=20
DYNAMIC_SKILL_REQUIRE_INTEGRITY=true
DYNAMIC_SKILL_REQUIRE_SIGNATURE=true
DYNAMIC_SKILL_SIGNING_KEY=CHANGE_ME_STRONG_RANDOM_SECRET
MAX_TOOL_RESULT_CHARS=1000000
AGENT_MAX_STEPS=8
MAX_CONVERSATION_MESSAGES=12
TELEGRAM_ADMIN_USER_IDS=''
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=sai:chat
REDIS_CONVERSATION_TTL_SECONDS=604800
INCLUDE_TOKEN_USAGE_IN_RESPONSE=true
REMINDER_POLL_INTERVAL_SECONDS=10
REMINDER_MAX_JOBS_PER_TICK=10
REMINDER_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/sai_reminders
